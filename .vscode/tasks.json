{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Java Current File",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "cd /d ${fileDirname} && (javac ${fileBasename} && java ${fileBasenameNoExtension} < input.txt) > output.txt 2>&1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}